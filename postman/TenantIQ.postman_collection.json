{
  "info": {
    "name": "TenantIQ API",
    "description": "Active TenantIQ backend endpoints. Set baseUrl for your running backend and use Login Admin to save the bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "targetUserId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Test Tenant\",\n  \"email\": \"tenant@example.com\",\n  \"password\": \"TenantPass123\",\n  \"role_id\": 2\n}" },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login Admin",
      "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', body.data.token);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"change-this-admin-password\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Pending Approvals",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/approve/pending" }
    },
    {
      "name": "Approve or Reject User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"target_user_id\": \"{{targetUserId}}\",\n  \"action\": \"APPROVED\",\n  \"reason\": \"Postman test\"\n}" },
        "url": "{{baseUrl}}/api/approve/action"
      }
    },
    {
      "name": "Admin Dashboard",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/users/admin-dashboard" }
    },
    {
      "name": "Change User Status",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"action\": \"DISABLED\",\n  \"reason\": \"Postman test\"\n}" },
        "url": "{{baseUrl}}/api/users/{{targetUserId}}/status"
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\"\n}" },
        "url": "{{baseUrl}}/api/auth/forgot-password"
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"paste-reset-token-here\",\n  \"password\": \"NewPassword123\"\n}" },
        "url": "{{baseUrl}}/api/auth/reset-password"
      }
    }
  ]
}
