# Docker Compose configuration. Copy to .env and replace all placeholder secrets.
POSTGRES_DB=tenantiq
POSTGRES_USER=tenantiq
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8080
SMTP_USER=
SMTP_PASS=
# Optional initial administrator. Set both values to bootstrap an active admin.
ADMIN_NAME=TenantIQ Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
